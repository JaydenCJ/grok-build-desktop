{
  "name": "grok-desktop",
  "private": true,
  "version": "0.4.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "absorb": "python3 scripts/absorb_repo.py",
    "dev": "vite",
    "doctor": "python3 scripts/doctor.py",
    "build": "tsc && vite build",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/smoke_test.mjs",
    "test:e2e": "node e2e/smoke.e2e.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "mac:build": "tauri build --bundles app",
    "mac:build:dmg": "tauri build --bundles dmg",
    "mac:dev": "tauri dev",
    "mac:install": "bash scripts/install_mac_app.sh",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-virtuoso": "^4.18.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.7"
  }
}
