{
  "name": "grok-desktop",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "absorb": "python3 scripts/absorb_repo.py",
    "chrome:check": "node --check chrome-extension/src/background.js && node --check chrome-extension/src/content.js && node --check chrome-extension/src/popup.js",
    "chrome:host": "python3 scripts/install_chrome_native_host.py",
    "dev": "vite",
    "doctor": "python3 scripts/doctor.py",
    "build": "tsc && vite build",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "node scripts/smoke_test.mjs",
    "mac:build": "tauri build --bundles app",
    "mac:build:dmg": "tauri build --bundles dmg",
    "mac:dev": "tauri dev",
    "mac:install": "bash scripts/install_mac_app.sh",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
