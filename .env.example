# Grok Build Desktop — example environment.
# Copy to .env (git-ignored) and fill in. Tauri dev does NOT auto-load .env;
# export these in your shell before launching, OR place them in
# ~/.grok-desktop/.env (loaded by the Telegram daemon on a fixed path).

# --- Grok CLI runner ---
GROK_DESKTOP_PYTHON=python3
GROK_DESKTOP_GROK_CMD=grok
GROK_DESKTOP_GROK_ARGS=--no-alt-screen --model grok-build --effort high -p {prompt} --output-format plain
GROK_DESKTOP_GROK_CHECK=false
GROK_DESKTOP_COMMAND_TIMEOUT_SECS=240
GROK_DESKTOP_GROK_MAX_TURNS=12
GROK_DESKTOP_VERBOSE_GROK_STDERR=0

# --- API keys (optional; Grok can also use a cached `grok login`) ---
XAI_API_KEY=
BROWSER_USE_API_KEY=

# === Telegram remote control (sub-project E, v0.2.0+) ===
# When TELEGRAM_BOT_TOKEN is set, the desktop app spawns a Telegram bot daemon
# that long-polls for commands (/grok /queue /cancel /status /help) and edits
# the originating Telegram message as Grok streams its response.
#
# TELEGRAM_BOT_TOKEN: from @BotFather. KEEP SECRET. If you ever paste it
# anywhere visible, immediately revoke via @BotFather → /mybots → your bot
# → API Token → Revoke current token.
TELEGRAM_BOT_TOKEN=

# Comma-separated i64 chat IDs allowed to issue commands.
# Daemon refuses to start with an empty allowlist (no public operation).
# Get your chat ID via:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# after sending /start to your bot.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional override for the working directory the bot uses on /grok.
# Falls back to session_state.json:coding_cwd, then $HOME.
# TELEGRAM_DEFAULT_CWD=/Users/you/code/some-project
