# Grok Build Desktop — example environment.
# Copy to .env (git-ignored) and fill in. Tauri dev does NOT auto-load .env;
# export these in your shell before launching.

# --- Grok CLI runner ---
GROK_DESKTOP_PYTHON=python3
GROK_DESKTOP_GROK_CMD=grok
GROK_DESKTOP_COMMAND_TIMEOUT_SECS=240
GROK_DESKTOP_VERBOSE_GROK_STDERR=0

# Kill a queued run if grok prints NOTHING on stdout for this many seconds
# (default 420). The timer resets on every line, so a run that is actively
# thinking (streaming-json emits thought events continuously) never trips it —
# it only fires when grok is truly silent, e.g. blocked on an offscreen macOS
# permission prompt or wedged. (src-tauri/src/runs/queue.rs)
GROK_DESKTOP_NO_OUTPUT_TIMEOUT_SECS=420

# Set to 1 to stop mirroring grok's stderr lines into the host process output
# ("[grok stderr] …", useful when diagnosing grok misbehavior; any other value
# keeps the mirroring on). (src-tauri/src/runs/queue.rs)
GROK_DESKTOP_QUIET_GROK_STDERR=0

# --- API keys (optional; Grok can also use a cached `grok login`) ---
XAI_API_KEY=
BROWSER_USE_API_KEY=
